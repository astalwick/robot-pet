[Unit]
Description=Robot lidar - RPLidar A1 publishing /scan in the laser frame
After=network-online.target
Wants=network-online.target
# Without the lidar plugged in, start is a clean no-op (so setup/redeploy/restart
# stay simple). The udev rule in setup.sh starts this unit when the lidar appears
# and stops it when it is unplugged.
# rplidar_node is a lifecycle node; the package's launch file drives it through
# configure/activate for us. publish_tf is off because the URDF owns the laser frame.
ConditionPathExists=/dev/rplidar

[Service]
Type=simple
User=pi
ExecStart=/bin/bash -c 'source /opt/ros/lyrical/setup.bash && set -a && source /home/pi/.config/robot-pet/ros.env && set +a && exec ros2 launch rplidar_driver rplidar_with_args.launch.py serial_port:=/dev/rplidar serial_baudrate:=115200 frame_id:=laser angle_compensate:=true publish_tf:=false'
Restart=always
RestartSec=2
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
