[Unit]
Description=Robot twist_mux - merges /cmd_vel_teleop and /cmd_vel_nav into /cmd_vel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=/bin/bash -c 'source /opt/ros/lyrical/setup.bash && set -a && source /home/pi/.config/robot-pet/ros.env && set +a && exec ros2 run twist_mux twist_mux --ros-args --params-file /home/pi/robot-pet/config/twist_mux.yaml -r cmd_vel_out:=/cmd_vel'
Restart=always
RestartSec=2
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
