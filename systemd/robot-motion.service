[Unit]
Description=Robot Motion - RoboClaw owner, safety gating, voice intents
After=robot-telemetry.service robot-sensors.service
Wants=robot-telemetry.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/robot-pet/src
Environment=PYTHONPATH=/home/pi/robot-pet/src
ExecStart=/home/pi/robot-pet/.venv/bin/python /home/pi/robot-pet/src/robot_motion.py
Restart=always
RestartSec=2
RuntimeDirectory=robot-pet
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
