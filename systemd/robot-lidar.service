[Unit]
Description=Robot lidar - RPLidar A1 publishing /scan in the laser frame
After=network-online.target
Wants=network-online.target
# Without the lidar plugged in, start is a clean no-op (so setup/redeploy/restart
# stay simple). The udev rule in setup.sh starts this unit when the lidar appears
# and stops it when it is unplugged.
# rplidar_node is a lifecycle node; config/rplidar.launch.py configures and
# activates it once, then leaves deactivate/activate to whoever needs the lidar.
ConditionPathExists=/dev/rplidar

[Service]
Type=simple
User=pi
ExecStart=/bin/bash -c 'source /opt/ros/lyrical/setup.bash && set -a && source /home/pi/.config/robot-pet/ros.env && set +a && exec ros2 launch /home/pi/robot-pet/config/rplidar.launch.py'
Restart=always
RestartSec=2
TimeoutStopSec=10
# The A1's motor runs whenever the USB adapter's DTR line is low. Opening the
# port raises DTR, but closing it drops DTR again, so the motor spins back up
# the moment the driver exits. stty opens the port (raising DTR) and turns off
# hupcl so DTR stays up after it closes. "-" because the lidar may be unplugged.
ExecStopPost=-/usr/bin/stty -F /dev/rplidar -hupcl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
