[Unit]
Description=Robot Motion - RoboClaw owner, safety gating, voice intents
After=robot-telemetry.service robot-battery.service robot-sensors.service
Wants=robot-telemetry.service robot-battery.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/robot-pet/src
Environment=PYTHONPATH=/home/pi/robot-pet/src
ExecStart=/home/pi/robot-pet/.venv/bin/python /home/pi/robot-pet/src/robot_motion.py
Restart=always
RestartSec=2
RuntimeDirectory=robot-pet
RuntimeDirectoryMode=0755
# yes, not restart: several services share /run/robot-pet. With "restart",
# stopping any one of them makes systemd delete the whole directory, wiping the
# other services' sockets (e.g. motion-intent.sock) out from under live
# processes. "yes" means systemd never tears it down; each service unlinks and
# rebinds only its own socket on start. /run is tmpfs, cleared on reboot.
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
