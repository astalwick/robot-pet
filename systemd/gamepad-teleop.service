[Unit]
Description=Gamepad Teleop - RoboClaw closed-loop speed control
After=robot-brain.service robot-telemetry.service
Wants=robot-brain.service robot-telemetry.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/robot-pet/src
Environment=PYTHONPATH=/home/pi/robot-pet/src
ExecStart=/home/pi/robot-pet/.venv/bin/python /home/pi/robot-pet/src/gamepad_teleop.py
Restart=always
RestartSec=2
RuntimeDirectory=robot-pet-gamepad
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
